# Server Port & Runtime
PORT=3000
NODE_ENV=development

# APP_URL: The public URL where this app is hosted (e.g. https://seven-sunday-connect.onrender.com)
APP_URL=

# Persistent Storage Directory for Uploaded Product Images & Chat Attachments (Mount a Render Disk here)
UPLOAD_DIR=./uploads

# WebRTC STUN/TURN Configuration (Optional TURN credentials for strict corporate/cellular NATs)
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# GEMINI_API_KEY: Required only if Gemini AI features are enabled
GEMINI_API_KEY=

# Optional External Messaging & Notification Integrations (Server-Side Only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_WEBHOOK_URL=
RESEND_API_KEY=
EMAIL_FROM=
