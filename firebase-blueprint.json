{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Private user account record with role, accountType, verification, and security settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 40 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "accountType": { "type": "string", "enum": ["employee", "customer", "external_guest"] },
        "role": { "type": "string", "enum": ["super_admin", "company_admin", "it_admin", "hr_manager", "department_manager", "meeting_admin", "meeting_organizer", "meeting_moderator", "employee", "support_agent", "customer", "external_guest"] },
        "status": { "type": "string", "enum": ["active", "pending_approval", "suspended", "deactivated", "blocked"] },
        "departmentId": { "type": "string", "maxLength": 128 },
        "departmentName": { "type": "string", "maxLength": 120 },
        "jobTitle": { "type": "string", "maxLength": 120 },
        "availability": { "type": "string", "enum": ["available", "busy", "dnd", "away", "offline"] },
        "mfaEnabled": { "type": "boolean" },
        "biometricEnabled": { "type": "boolean" },
        "forcePasswordChange": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "accountType", "role", "status", "createdAt", "updatedAt"]
    },
